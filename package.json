{
  "name": "skills-license-checker",
  "version": "0.0.3",
  "description": "A JS library to help JS/TS developers quickly generate information regarding Agent Skills for use at the project level.",
  "homepage": "https://github.com/composable-tu/skills-license-checker#readme",
  "bugs": {
    "url": "https://github.com/composable-tu/skills-license-checker/issues"
  },
  "license": "MulanPSL-2.0",
  "author": "composable-tu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/composable-tu/skills-license-checker.git"
  },
  "bin": {
    "skills-license-checker": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "front-matter": "^4.0.2",
    "git-url-parse": "^16.1.0",
    "spdx-correct": "^3.2.0",
    "spdx-license-list": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/spdx-correct": "^3.1.3",
    "bumpp": "^12.1.1",
    "citty": "^0.2.2",
    "pkg-pr-new": "^0.0.82",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "inlinedDependencies": {
    "citty": "0.2.2"
  }
}
